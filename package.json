{
  "name": "browser-evidence-studio",
  "productName": "Browser Evidence Studio",
  "version": "0.1.0",
  "description": "Local browser demonstration, evidence and validation workbench",
  "private": true,
  "type": "module",
  "main": ".vite/build/index.js",
  "author": "Browser Evidence Studio contributors",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "electron-forge start",
    "start:agent": "node scripts/start-agent.mjs",
    "browser:baseline": "node scripts/browser-baseline.mjs",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts && vite build --config vite.portable.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && node test/desktop/launch.js",
    "test:desktop": "npm run test:integration",
    "test:startup": "node test/desktop/launch.js --startup-only --dev",
    "test:soak": "npm run build && node test/desktop/launch.js --soak=30",
    "test:example": "node --import tsx --test test/release/orders-standalone.test.mjs",
    "test:release-assets": "node test/release/package-assets.mjs",
    "example:jd-account": "node examples/jd-account-export/standalone.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "parse5": "8.0.1",
    "puppeteer-core": "25.11.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.13.2",
    "rrweb": "2.1.6",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "electron": "44.4.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "config": {
    "forge": "./forge.config.ts"
  }
}
